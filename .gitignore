# ============================================================
# 1. 凭据与私密信息 — 绝不入库（API Key / Token / 私钥）
# ============================================================
.env
.env.*
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*credential*
*secret*
*token*
.github-bridge.json

# ============================================================
# 2. 内部开发文档 — 不纳入版本控制（避免内部信息泄漏）
# ============================================================
AGENTS.md
DESIGN.md
CLAUDE.md
TODO.md
NOTES.md

# ============================================================
# 3. 平台 / 开发工具配置目录 — 不上传
#    例外：.coze 是沙箱构建/部署的唯一启动依据，必须入库
# ============================================================
.coze
!.coze
.cozeproj/
.codegraph/
.preview
.vscode/
.idea/
*.iml
*.swp
.cursor/
.devcontainer/
storybook-static/

# ============================================================
# 4. 依赖
# ============================================================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ============================================================
# 5. 构建产物
# ============================================================
.next/
out/
build/
dist/
.turbo
.vercel
.parcel-cache
.cache
coverage/
*.tsbuildinfo
next-env.d.ts

# ============================================================
# 6. 日志与临时文件
# ============================================================
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
output.log

# ============================================================
# 7. 系统与编辑器杂项
# ============================================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================
# 8. 大体积媒体与归档 — 不入库
# ============================================================
*.zip
*.rar
*.7z
*.tar
*.gz
*.iso
*.dmg
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.mkv
*.webm
*.m4v
